# Copia este archivo a ".env" y rellena los valores de TU proyecto Firebase.
# Nunca subas .env al repositorio.
# Obtén los valores en: Firebase Console > Configuración del proyecto > Tus apps.
#
# Arranque: flutter run --dart-define-from-file=.env
# (Cursor/VS Code ya lo incluye en .vscode/launch.json)

FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

FIREBASE_ANDROID_API_KEY=AIzaSy________________________
FIREBASE_ANDROID_APP_ID=1:123456789:android:abcdef

FIREBASE_IOS_API_KEY=AIzaSy________________________
FIREBASE_IOS_APP_ID=1:123456789:ios:abcdef
FIREBASE_IOS_BUNDLE_ID=com.daleu.dale_u

# Client ID web (oauth_client client_type: 3). Obligatorio en Android para idToken.
GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Client ID iOS (opcional en Android). Obligatorio si compilas iOS.
GOOGLE_IOS_CLIENT_ID=

# Opcional. Dónde vive la página del estado de cuenta (Firebase Hosting).
# Por defecto: https://<FIREBASE_PROJECT_ID>.web.app
STATEMENT_BASE_URL=
